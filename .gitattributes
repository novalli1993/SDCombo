# ============================================================================
#  行尾策略：git 内统一 LF，检出到工作区也用 LF（Python/文本）
#  Windows 批处理保持 CRLF
# ============================================================================
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf

# ---- 二进制（禁止行尾转换）----
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.pth binary
*.pyd binary
*.lib binary
*.exp binary
*.obj binary
*.zip binary
*.xlsx binary
*.egg binary
